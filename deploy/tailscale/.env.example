#
# server/compose.yaml + deploy/tailscale/compose.override.yml (deploy/tailscale/README.md).
# Copy to .env next to compose.yaml and fill in. No secrets here: they go in ./secrets/.

# Tag of the image you built and loaded (README step 1).
UT_VERSION=local-0000000
# A folder for UltimateTunes' library, owned by uid 10001 (README step 2).
UT_MUSIC_PATH=/srv/ultimatetunes/music
# Local only: `tailscale serve` publishes it inside your tailnet.
UT_BIND=127.0.0.1:8044
# The gateway of the pinned default network in compose.override.yml, as a /32.
UT_TRUSTED_PROXIES=10.213.46.1/32

# Optional PO token provider against YouTube's "Sign in to confirm you're not a bot"
# (docs/admin-guide.md). Remove both lines to turn it off (README, "Turning the provider off").
COMPOSE_PROFILES=pot
UT_YTDLP_POT_PROVIDER_URL=http://bgutil:4416

# yt-dlp player clients (docs/admin-guide.md, "songs cut off or skip"). The worker defaults to
# web_safari,tv (tuned for the provider above); uncomment to override, e.g. `default` with no
# provider, or a comma list of clients to try in order.
# UT_YTDLP_PLAYER_CLIENTS=web_safari,tv

# Change only if they overlap one of your networks (keep the addresses inside the subnets):
# UT_INTERNAL_SUBNET=10.213.44.0/24
# UT_API_INTERNAL_ADDRESS=10.213.44.250
# UT_EGRESS_SUBNET=10.213.45.0/24
# UT_POT_SUBNET=10.213.47.0/24
# UT_POT_PROVIDER_ADDRESS=10.213.47.250
