#
# EXAMPLE ONLY: every variable that server/compose.yaml + compose.override.yml read for the
# Traefik + Cloudflare Tunnel setup. Copy it to `.env` in this folder (git-ignored) and replace
# the example values (example.com, RFC 1918 example ranges). Pass it with
# `docker compose --env-file deploy/traefik-cloudflared/.env ...` (README.md).
#
# NO SECRETS IN THIS FILE. Secrets are files under server/secrets/ (mode 600, never committed):
#   server/secrets/worker_token               openssl rand -hex 32  (api <-> worker, 32+ chars)
#   server/secrets/admin_session_secret       openssl rand -hex 32  (signs admin sessions)
#   server/secrets/bootstrap_admin_password   first admin only, then delete it (README.md)
#   server/secrets/notify_token               optional: ntfy access token (notifications below)
# The Cloudflare Tunnel token belongs to cloudflared's own stack, never here.

# ---- image and library --------------------------------------------------------------------
# Image tag. Publishing is paused: build it locally with this tag (README.md, step 1).
UT_VERSION=0.1.0
# Your music library on the host (mounted as /music in the api and the worker).
UT_MUSIC_PATH=/srv/music
# Not used here: the override removes the api's host port (Traefik reaches it on its network).
# UT_BIND=127.0.0.1:8044

# ---- Traefik ------------------------------------------------------------------------------
# Public hostname: the Cloudflare Tunnel public hostname and the Traefik routers' Host rule.
UT_PUBLIC_HOST=tunes.example.com
# Traefik's existing Docker network, and its subnet (also denied /admin in the api).
UT_TRAEFIK_NETWORK=traefik
UT_TRAEFIK_SUBNET=172.30.0.0/24
# Traefik's HTTPS entrypoint, certificate resolver and Authelia forwardAuth middleware names.
UT_TRAEFIK_ENTRYPOINT=websecure
UT_TRAEFIK_CERTRESOLVER=letsencrypt
UT_AUTHELIA_MIDDLEWARE=authelia@file
# Sources allowed to reach /admin, POST /ut/v1/keys and /readyz at Traefik (comma-separated,
# matched against the TCP peer): your LAN and, if Traefik is on the tailnet, Tailscale. Never
# 172.16.0.0/12 or the Traefik network: cloudflared connects from there.
UT_EDGE_LAN_RANGES=192.168.1.0/24,100.64.0.0/10

# ---- client address (api) -----------------------------------------------------------------
# Traefik's and cloudflared's PINNED addresses on UT_TRAEFIK_SUBNET, each as a /32. Never the
# whole subnet: any container there could then claim any client address.
UT_TRUSTED_PROXIES=172.30.0.2/32,172.30.0.250/32
# Who may open /admin (resolved client address): loopback (docker compose exec), your LAN's
# /24 and the tailnet. NEVER the Docker ranges (172.16.0.0/12) nor the tunnel's network.
UT_ADMIN_ALLOWED_NETWORKS=127.0.0.1/32,::1/128,192.168.1.0/24,100.64.0.0/10,fd7a:115c:a1e0::/48

# ---- api <-> worker networks (server/compose.yaml) ----------------------------------------
# Pinned subnets of the api-worker network and the worker's way out; change them if they
# overlap one of yours. Both are denied /admin.
UT_INTERNAL_SUBNET=10.213.44.0/24
# The api's pinned address on UT_INTERNAL_SUBNET: the internal worker API (8045) listens only
# there, so no other network the api is on (Traefik's) can reach it.
UT_API_INTERNAL_ADDRESS=10.213.44.250
UT_EGRESS_SUBNET=10.213.45.0/24

# Connection limits of the api's client listener: open connections, idle keep-alive seconds.
UT_LIMIT_CONCURRENCY=128
UT_KEEPALIVE_TIMEOUT_S=5

# ---- optional PO token provider (docs/admin-guide.md, "not a bot") ------------------------
# Only if downloads keep failing with "Sign in to confirm you're not a bot". Uncomment both:
# the profile starts the pot-provider container, the URL makes the worker use it.
# COMPOSE_PROFILES=pot
# UT_YTDLP_POT_PROVIDER_URL=http://bgutil:4416
# Its network with the worker, and its pinned address there (change them if they overlap).
# UT_POT_SUBNET=10.213.47.0/24
# UT_POT_PROVIDER_ADDRESS=10.213.47.250

# ---- logs ---------------------------------------------------------------------------------
# DEBUG, INFO, WARNING or ERROR (JSON to stdout; secrets are redacted).
UT_LOG_LEVEL=INFO

# ---- download limits (api and worker) -----------------------------------------------------
# Longest song downloaded, in seconds.
UT_MAX_TRACK_DURATION_S=1800
# Largest single download, in bytes (200 MiB).
UT_MAX_DOWNLOAD_BYTES=209715200
# Queued or running downloads per user.
UT_MAX_QUEUED_JOBS_PER_USER=200
# Bytes each user may download over the last 24 hours (5 GiB).
UT_MAX_DOWNLOAD_BYTES_PER_DAY_PER_USER=5368709120
# Nothing is queued or claimed below this many free bytes on /music or /staging (2 GiB).
UT_MIN_FREE_BYTES=2147483648

# ---- notifications ------------------------------------------------------------------------
# How often (seconds) failed downloads and canary runs are checked for notifications. The
# target itself (an ntfy topic or a webhook URL) is set in the panel (Notifications) and kept
# in the database.
UT_ADMIN_NOTIFY_INTERVAL_S=60
# Only for an ntfy server that requires login (../README.md, "Notifications with ntfy"): the
# one host (and port, if not 443) the credentials may be sent to. Required with credentials,
# ignored without. Leave it empty for a public ntfy topic.
UT_NOTIFY_HOST=
# The credentials themselves NEVER go here: put the access token in
# server/secrets/notify_token (one line, mode 600) and uncomment the `notify_token` secret in
# server/compose.yaml (under the api's `secrets:` and at the end of the file). Or a user and
# password as the Docker secrets ut_notify_username + ut_notify_password; not both.

# ---- first admin --------------------------------------------------------------------------
# No variable: the first admin is created once with `bootstrap-admin`, reading the password
# from server/secrets/bootstrap_admin_password on standard input (README.md, step 4).
