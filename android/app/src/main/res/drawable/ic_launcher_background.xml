<!-- The app logo's tile (Connect screen, `placeholderBrush("UltimateTunes")`): a diagonal
     gradient from the accent pink to coral, top-left to bottom-right. The gradient spans the
     72dp a launcher mask shows, so the visible colours match the in-app logo. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endColor="#FFFF8A5C"
                android:endX="90"
                android:endY="90"
                android:startColor="#FFE0284F"
                android:startX="18"
                android:startY="18"
                android:type="linear" />
        </aapt:attr>
    </path>
</vector>
