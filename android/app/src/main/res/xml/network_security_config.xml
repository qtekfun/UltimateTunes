  HTTPS only (SPEC §7): cleartext traffic is refused and only the system CAs are trusted.
  Debug builds replace this file to also allow the emulator's host (src/debug).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
